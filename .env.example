# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Database ---
# Priority: DATABASE_URL > DB_ENGINE + POSTGRES_* > default SQLite

# Option A: Set trực tiếp (production/staging - override toàn bộ)
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/hrm"

# Option B: Build từ components
# DB_ENGINE=sqlite | postgres   (default: sqlite)
DB_ENGINE="sqlite"

# AUTO_CREATE_SCHEMA:
# - mặc định true với SQLite
# - mặc định false với Postgres
# - có thể override bằng true/false khi cần
AUTO_CREATE_SCHEMA=""

# SQLite (chỉ dùng khi DB_ENGINE=sqlite)
SQLITE_PATH="./hrm.db"

# Postgres (chỉ dùng khi DB_ENGINE=postgres)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="hrm"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# --- AWS S3 / Compatible Storage ---
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
AWS_REGION="ap-southeast-1"
S3_BUCKET="hrm-bucket"
# S3_ENDPOINT_URL: Để trống khi dùng AWS thật.
# Set URL khi dùng MinIO hoặc LocalStack, ví dụ: http://localhost:9000
S3_ENDPOINT_URL=""
